<Window x:Class="footwear_wpf.CreateOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:footwear_wpf"
        mc:Ignorable="d"
        Title="CreateOrderWindow" Height="450" Width="800">
    <Grid>

        <ComboBox x:Name = "cbArticleProcut" HorizontalAlignment="Left" Margin="28,56,0,0" VerticalAlignment="Top" Width="149" Height="19" DisplayMemberPath="product_name" SelectedValuePath="article"/>
        <ComboBox x:Name = "cbAddress" HorizontalAlignment="Left" Margin="28,80,0,0"  VerticalAlignment="Top" Width="149" Height="19" DisplayMemberPath="name" SelectedValuePath="id"/>
        <ComboBox x:Name = "cbUser" HorizontalAlignment="Left" Margin="28,103,0,0" VerticalAlignment="Top" Width="149" Height="19" DisplayMemberPath="fullname" SelectedValuePath="id"/>
        <Label Content="Выберите товар" HorizontalAlignment="Left" Margin="191,51,0,0" VerticalAlignment="Top" Height="33" Width="209" RenderTransformOrigin="0.486,0.676"/>
        <Label Content="Выберите адрес" HorizontalAlignment="Left" Margin="191,73,0,0" VerticalAlignment="Top" Height="33" Width="209" RenderTransformOrigin="0.486,0.676"/>
        <Label Content="Выберите пользователя" HorizontalAlignment="Left" Margin="191,96,0,0" VerticalAlignment="Top" Height="33" Width="209" RenderTransformOrigin="0.486,0.676"/>


        <Button Content="Создать заказ" HorizontalAlignment="Left" Margin="28,127,0,0" VerticalAlignment="Top" Height="19" Width="149" Click="BtnCreateOrder"/>

    </Grid>
</Window>
