<Window x:Class="footwear_wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:footwear_wpf"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        
        <TextBox Name = "tbLogin" HorizontalAlignment="Center" Margin="0,172,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="170" Height="32"/>
        <TextBox Name = "tbPassword" HorizontalAlignment="Center" Margin="0,226,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="170" Height="32"/>
        <Label Content="Логин" HorizontalAlignment="Left" Margin="250,175,0,0" VerticalAlignment="Top"/>
        <Label Content="Пароль" HorizontalAlignment="Left" Margin="250,224,0,0" VerticalAlignment="Top"/>
        <Button Content="Войти как гость" HorizontalAlignment="Left" Margin="442,287,0,0" VerticalAlignment="Top" Height="28" Width="96" Click="BtnEnterGuest"/>
        <Button Content="Войти" HorizontalAlignment="Left" Margin="280,287,0,0" VerticalAlignment="Top" Height="28" Width="96" Click="BtnEnterWithRole"/>

    </Grid>
</Window>
