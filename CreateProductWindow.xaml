<Window x:Class="footwear_wpf.CreateProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:footwear_wpf"
        mc:Ignorable="d"
        Title="CreateProductWindow" Height="450" Width="800">
    <Grid>

        <TextBox x:Name = "tbProductName" HorizontalAlignment="Left" Margin="28,32,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="149" Height="19"/>
        <TextBox x:Name = "tbUnit" HorizontalAlignment="Left" Margin="28,56,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="149" Height="19"/>
        <TextBox x:Name = "tbPrice" HorizontalAlignment="Left" Margin="28,80,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="149" Height="19"/>
        <ComboBox x:Name = "cbSupplier" HorizontalAlignment="Left" Margin="28,104,0,0"  VerticalAlignment="Top" Width="149" Height="19" DisplayMemberPath="name" SelectedValuePath="id"/>
        <ComboBox x:Name = "cbManufacture" HorizontalAlignment="Left" Margin="28,128,0,0"  VerticalAlignment="Top" Width="149" Height="19" DisplayMemberPath="name" SelectedValuePath="id"/>
        <ComboBox x:Name = "cbCategory" HorizontalAlignment="Left" Margin="28,152,0,0" VerticalAlignment="Top" Width="149" Height="19" DisplayMemberPath="name" SelectedValuePath="id"/>
        <TextBox x:Name = "tbDiscount" HorizontalAlignment="Left" Margin="28,176,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="149" Height="19"/>
        <TextBox x:Name = "tbStock" HorizontalAlignment="Left" Margin="28,200,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="149" Height="19"/>
        <TextBox x:Name = "tbDescription" HorizontalAlignment="Left" Margin="28,224,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="149" Height="19"/>


        <Label Content="Введите название продукта" HorizontalAlignment="Left" Margin="191,25,0,0" VerticalAlignment="Top" Height="33" Width="172" RenderTransformOrigin="0.486,0.676"/>
        <Label Content="Введите единицу измерения товара" HorizontalAlignment="Left" Margin="191,51,0,0" VerticalAlignment="Top" Height="33" Width="209" RenderTransformOrigin="0.486,0.676"/>
        <Label Content="Введите цену товара" HorizontalAlignment="Left" Margin="191,73,0,0" VerticalAlignment="Top" Height="33" Width="209" RenderTransformOrigin="0.486,0.676"/>
        <Label Content="Выберите поставщика" HorizontalAlignment="Left" Margin="191,97,0,0" VerticalAlignment="Top" Height="33" Width="209" RenderTransformOrigin="0.486,0.676"/>
        <Label Content="Выберите производителя" HorizontalAlignment="Left" Margin="191,120,0,0" VerticalAlignment="Top" Height="33" Width="209" RenderTransformOrigin="0.486,0.676"/>
        <Label Content="Выберите категорию товара" HorizontalAlignment="Left" Margin="191,144,0,0" VerticalAlignment="Top" Height="33" Width="209" RenderTransformOrigin="0.486,0.676"/>
        <Label Content="Введите скидку на товар" HorizontalAlignment="Left" Margin="191,169,0,0" VerticalAlignment="Top" Height="33" Width="209" RenderTransformOrigin="0.486,0.676"/>
        <Label Content="Введите кол-во на складе" HorizontalAlignment="Left" Margin="191,193,0,0" VerticalAlignment="Top" Height="33" Width="209" RenderTransformOrigin="0.486,0.676"/>
        <Label Content="Введите описание товара" HorizontalAlignment="Left" Margin="191,217,0,0" VerticalAlignment="Top" Height="33" Width="209" RenderTransformOrigin="0.486,0.676"/>
        
        
        <Button Content="Создать продукт" HorizontalAlignment="Left" Margin="28,263,0,0" VerticalAlignment="Top" Height="19" Width="149" Click="Button_Click"/>

    </Grid>
</Window>
